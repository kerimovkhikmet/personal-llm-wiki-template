# Obsidian — local editor state (workspace layout, cache, graph position),
# not template content. This template ships no .obsidian/ config; Obsidian
# generates its own on first open, wherever a vault is opened in this repo.
**/.obsidian/

# opencode local/session artifacts (do NOT ignore .opencode/agent,
# .opencode/command, .opencode/skills)
.opencode/cache/
.opencode/logs/
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock

